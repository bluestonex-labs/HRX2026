<mvc:View
	controllerName="bsx.hrx.hrx2026.controller.AppExplorer"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.f"
	displayBlock="true">
	<Page id="explorerPage" showHeader="false" showNavButton="false" class="hrxPageContent">
		<f:GridContainer
			items="{app>/explorerApps}"
			snapToRow="true"
			class="sapUiSmallMarginTop sapUiSmallMarginBeginEnd">
			<f:layout>
				<f:GridContainerSettings rowSize="5.5rem" columnSize="17rem" gap="1rem" />
			</f:layout>
			<GenericTile
				class="hrxAppTile"
				header="{app>title}"
				subheader="{app>subtitle}"
				mode="HeaderMode"
				frameType="TwoByHalf"
				press="onTilePress" />
		</f:GridContainer>
	</Page>
</mvc:View>
