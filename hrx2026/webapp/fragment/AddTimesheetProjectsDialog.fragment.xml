<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">

	<Dialog
		id="addTimesheetProjectsDialog"
		title="{i18n>tsAddProjectsTitle}"
		contentWidth="auto"
		contentHeight="28rem"
		resizable="false"
		busy="{tsView>/saving}"
		busyIndicatorDelay="0"
		class="hrxPickerDialog">
		<content>
			<Table
				id="addProjectsTable"
				items="{ts>/available}"
				mode="MultiSelect"
				growing="true"
				growingThreshold="50"
				sticky="ColumnHeaders"
				class="hrxPickerTable"
				noDataText="{i18n>tsNoAvailableProjects}">
				<columns>
					<!-- Fixed widths for the two short columns so the three of them line up
					     down the list instead of shifting with the longest client name. -->
					<Column><Text text="{i18n>tsColProject}" /></Column>
					<Column width="11rem" minScreenWidth="Tablet" demandPopin="true">
						<Text text="{i18n>tsColClient}" />
					</Column>
					<Column width="7.5rem" hAlign="End" minScreenWidth="Tablet" demandPopin="true">
						<Text text="{i18n>tsColType}" />
					</Column>
				</columns>
				<items>
					<!-- Middle, so the two-line project cell and the single-line client and
					     type cells sit on one centre line. -->
					<ColumnListItem vAlign="Middle">
						<cells>
							<ObjectIdentifier title="{ts>ProjectDesc}" text="{ts>ProjectID}" />
							<Text text="{ts>ClientDesc}" />
							<Text text="{ts>ProjectTypeText}" />
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
		<beginButton>
			<Button id="addProjectsConfirm" text="{i18n>tsAddProjectsConfirm}" type="Emphasized" press=".onConfirmAddProjects" />
		</beginButton>
		<endButton>
			<Button id="addProjectsCancel" text="{i18n>tsCancel}" press=".onCancelAddProjects" />
		</endButton>
	</Dialog>
</core:FragmentDefinition>
