<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">

	<Popover
		id="timesheetCommentPopover"
		title="{i18n>tsCommentTitle}"
		placement="Auto"
		contentWidth="22rem"
		afterClose=".onCommentClosed"
		class="sapUiContentPadding">
		<VBox>
			<Text text="{tsComment>/label}" class="hrxResourceMeta sapUiTinyMarginBottom" />
			<TextArea
				id="timesheetCommentText"
				value="{tsComment>/comment}"
				editable="{tsComment>/editable}"
				rows="4"
				width="100%"
				growing="true"
				placeholder="{i18n>tsCommentPlaceholder}" />
		</VBox>
	</Popover>
</core:FragmentDefinition>
