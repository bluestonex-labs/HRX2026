<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:form="sap.ui.layout.form">

	<Dialog
		id="projectFilterDialog"
		title="{i18n>mpFilterTitle}"
		contentWidth="32rem">
		<content>
			<form:SimpleForm
				id="projectFilterForm"
				editable="true"
				layout="ResponsiveGridLayout"
				labelSpanXL="5"
				labelSpanL="5"
				labelSpanM="5"
				labelSpanS="12"
				adjustLabelSpan="false"
				emptySpanXL="0"
				emptySpanL="0"
				emptySpanM="0"
				emptySpanS="0"
				columnsXL="1"
				columnsL="1"
				columnsM="1"
				singleContainerFullSize="false">
				<form:content>
					<Label text="{i18n>mpFilterClient}" />
					<ComboBox
						id="filterProjectClient"
						selectedKey="{mpView>/filterDraft/client}"
						items="{mp>/clients}"
						width="100%"
						showSecondaryValues="true"
						placeholder="{i18n>mpFilterAllClients}">
						<core:ListItem key="{mp>ClientKey}" text="{mp>ClientDesc}" additionalText="{mp>ClientLocation}" />
					</ComboBox>

					<Label text="{i18n>mpFilterTimeBooking}" />
					<Select id="filterProjectTimeBooking" selectedKey="{mpView>/filterDraft/timeBooking}" width="100%">
						<core:Item key="Y" text="{i18n>mpStatusOpen}" />
						<core:Item key="N" text="{i18n>mpStatusClosed}" />
						<core:Item key="A" text="{i18n>mpFilterAll}" />
					</Select>
				</form:content>
			</form:SimpleForm>
		</content>
		<buttons>
			<Button id="projectFilterConfirm" text="{i18n>mpFilterConfirm}" type="Emphasized" press=".onConfirmFilter" />
			<Button id="projectFilterReset" text="{i18n>mpFilterReset}" press=".onClearFilter" />
			<Button id="projectFilterCancel" text="{i18n>mpCancel}" press=".onCancelFilter" />
		</buttons>
	</Dialog>
</core:FragmentDefinition>
